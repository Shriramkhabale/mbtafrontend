# MB MITRA Frontend Configuration Example
# Copy this file to .env for local development

# In local development:
# Backend running on default port 5000:
REACT_APP_API_URL=http://localhost:5000

# In production (Hostinger VPS / Nginx reverse proxy):
# Leave REACT_APP_API_URL empty or unset so the frontend uses relative /api routing
# matching the current browser origin without hardcoding any IP or domain.
# REACT_APP_API_URL=

